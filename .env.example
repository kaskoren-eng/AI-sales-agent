# Server
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Database
DATABASE_URL=postgresql://dev:dev@localhost:5432/ai_sales_agent

# Redis
REDIS_URL=redis://localhost:6379

# Encryption
ENCRYPTION_KEY=your-32-byte-hex-key-here

# JWT
JWT_SECRET=your-jwt-secret-here

# Operator console (super-admin). Optional: leave unset and every /api/v1/admin/* route replies 503.
# Set to a long random secret (>=24 chars) to enable the multi-tenant management console. This is a
# SEPARATE credential from tenant API keys — it grants cross-tenant powers (list/create/suspend/rotate).
ADMIN_API_KEY=

# Who may create a workspace: invite_only (default) or open.
#
# POST /auth/register creates a TENANT plus an owner account, and it is unauthenticated by
# necessity — obtaining a credential cannot itself require one. Left open, anyone who finds the API
# gets a workspace on a paid product, and a usage_period opens with it.
#
# LEAVE THIS UNSET unless you are deliberately opening self-serve signup. Closed locks nobody out:
# existing owners invite colleagues, and the first human on a new workspace comes from
# `node scripts/bootstrap-user.mjs --email you@example.com --tenant <slug>`, which needs database
# access — the right property for the power to mint a workspace.
SIGNUP_MODE=

# Lead intake webhooks
META_APP_SECRET=
LEAD_WEBHOOK_SECRET=
# UUID of the tenant that receives generic (non-Meta) webhook leads
LEAD_WEBHOOK_TENANT_ID=

# App base URL (for webhook callback URLs)
BASE_URL=http://localhost:3000
# Dashboard base URL — used for "view this call" links pushed into the CRM (Workstream B). Optional.
DASHBOARD_BASE_URL=http://localhost:3001

# ClickScales' own tenant id. The global integration credentials below (AIRTABLE_*, and in future
# GOOGLE_CALENDAR_*) are OUR account's, so only this tenant may fall back to them. Any other tenant
# must connect its own, or the step is skipped loudly. Leave unset and there is no fallback at all.
PLATFORM_TENANT_ID=
# Voicemail detection (outbound only, experimental). Off by default. When true, an outbound call that
# reaches an answering machine leaves a short message and hangs up instead of running discovery.
VOICE_AMD_ENABLED=false
# Advisory conversation-state layer (reflexes + stage/working-memory tracking + objection prompt).
# On by default. Set false to run Keren exactly as before the state machine — for A/B testing behaviour.
VOICE_STATE_MACHINE_ENABLED=true

# Channels - WhatsApp (UChat)
UCHAT_WEBHOOK_SECRET=
UCHAT_API_TOKEN=
# UUID of the tenant that receives inbound WhatsApp messages (server-side only — prevents body spoofing)
UCHAT_WEBHOOK_TENANT_ID=

# Channels - Email (Resend)
# Optional. Without it the API still boots and warns; invites, password resets and meeting
# reminders are silently skipped, and POST /members/invites returns the raw token instead.
RESEND_API_KEY=re_
RESEND_FROM_EMAIL=sales@yourdomain.com
RESEND_WEBHOOK_SECRET=
# UUID of the tenant that receives inbound emails (MVP single-tenant routing)
RESEND_INBOUND_TENANT_ID=

# Channels - Voice (Zadarma SIP telephony into the LiveKit agent)
# Zadarma — https://zadarma.com
# 1. Get your API key and secret from Zadarma portal → Settings → API
# 2. Set notification URL in Zadarma → My Notifications: https://<your-domain>/webhooks/voice/zadarma
ZADARMA_API_KEY=
ZADARMA_API_SECRET=
ZADARMA_PHONE_NUMBER=
# UUID of the tenant that receives inbound voice calls — enables learning injection into agent prompt
VOICE_WEBHOOK_TENANT_ID=

# Channels - Voice (LiveKit self-built pipeline) — the REPLACEMENT engine. See VOICE_MIGRATION_PLAN.md
# The agent runs as its own process, not inside this server: npm run voice:dev
# LiveKit Cloud — https://cloud.livekit.io → Settings → Keys
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# OUTBOUND SIP trunk id (ST_...). Outbound only — the inbound trunk is configured entirely on
# LiveKit (trunk + dispatch rule) and is referenced by no env var. Unset = outbound calls
# silently no-op and return callId 'skipped'. See infra/livekit-sip/README.md.
LIVEKIT_SIP_OUTBOUND_TRUNK_ID=
# Cartesia (Hebrew TTS) — https://play.cartesia.ai → API Keys
# Browse Hebrew voices at https://play.cartesia.ai/voices (filter: language = Hebrew) and paste the voice ID below.
# Valid models: sonic, sonic-2, sonic-3, sonic-lite, sonic-turbo. There is no sonic-4.
CARTESIA_API_KEY=sk_car_
CARTESIA_MODEL=sonic-3
CARTESIA_VOICE_ID_PRIMARY=
# Backup Hebrew voices — A/B candidates for the Phase 2 voice selection
CARTESIA_VOICE_ID_SECONDARY=
CARTESIA_VOICE_ID_TERTIARY=

# Which TTS engine speaks: cartesia | deepdub | elevenlabs  (default cartesia — the shipped voice)
# 'deepdub' selects the self-built DeepDub adapter (won a blind Hebrew A/B on quality + native
# gender at cost parity; realtime model ~125ms TTFB). 'elevenlabs' selects the official plugin
# (eleven_flash_v2_5) for a Hebrew voice A/B. Strangler-fig, one var to revert.
VOICE_TTS_PROVIDER=cartesia
# Recorded-call legal notice pre-roll (Wiretapping Law 1979 §2). Off unless 'true'/'1'. Disabled
# for now: the choppy PSTN playback is worse than none pre-launch. Re-enable after the frame-size
# fix is verified on a real phone call. Code stays in compliance/recording-notice.ts.
# VOICE_RECORDING_NOTICE_ENABLED=false
# DeepDub (only needed when VOICE_TTS_PROVIDER=deepdub). Keys/voices at https://app.deepdub.ai
DEEPDUB_API_KEY=dd-
DEEPDUB_VOICE_PROMPT_ID=
DEEPDUB_MODEL=dd-etts-3.2
DEEPDUB_REALTIME=true
DEEPDUB_LOCALE=he-IL
DEEPDUB_EU=true
DEEPDUB_SAMPLE_RATE=24000
DEEPDUB_ACCENT_RATIO=0.75
# ElevenLabs (only needed when VOICE_TTS_PROVIDER=elevenlabs). Key at https://elevenlabs.io — voice
# ID from your Voice Library. voiceId is MANDATORY (missing = silent empty stream, not an error).
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_flash_v2_5
# Force Hebrew on the ws stream. Empty for flash/turbo_v2_5 (they reject language_code=he → 1008 close);
# set 'he' for eleven_multilingual_v2 (accepts it → clean Hebrew).
ELEVENLABS_LANGUAGE=
# WS handshake levers. multilingual_v2/v3 403 the websocket when auto_mode/sync_alignment are requested;
# keep both false so the quality models can connect over the ws (flash/turbo tolerate either).
ELEVENLABS_AUTO_MODE=false
ELEVENLABS_SYNC_ALIGNMENT=false
# Route via HTTP instead of the websocket. Required for eleven_v3 / Voice-Design "generated" voices
# (they 403 the ws and only render on v3, which is HTTP-only). true → LiveKit StreamAdapter over HTTP.
ELEVENLABS_USE_HTTP=false
# optimize_streaming_latency (0-4) on the HTTP path — higher = lower TTS TTFB, slightly lower quality.
# Leave empty to omit. HTTP path only.
ELEVENLABS_STREAMING_LATENCY=

# OpenAI streaming STT — uses the OPENAI_API_KEY below
OPENAI_REALTIME_MODEL=gpt-realtime-whisper

# Which STT engine transcribes the caller: soniox | openai
# SONIOX. Settled on real Hebrew calls, not on vibes: semantic WER 4.3% vs OpenAI's 34.9% on
# phone-like audio, end-of-turn ~572ms vs ~1113ms, and 8.5x cheaper. On a live call OpenAI heard
# the caller's name קורן as כהן (a different person) and turned the last digits of his mobile into
# the Hebrew word for "sun". Re-run it yourself: npm run stt:ab
STT_PROVIDER=soniox
# REQUIRED when STT_PROVIDER=soniox. https://console.soniox.com → API Keys
SONIOX_API_KEY=
# Name the real model: the plugin's 'stt-rt-v4' default is an ALIAS for v5 upstream, so pinning it
# lets a silent upstream swap change transcription quality overnight.
SONIOX_MODEL=stt-rt-v5
# Only used when VOICE_TURN_DETECTION=stt, which you should not turn on. Plugin clamps to 500–3000.
SONIOX_MAX_ENDPOINT_DELAY_MS=500
# How the turn ends: vad (silence timer) | stt (Soniox's own endpoint). LEAVE THIS ON vad.
# 'stt' was tested on a real call and CUT THE CALLER OFF ten times — the agent went silent on him
# three times mid-conversation. Soniox's endpoint is a silence detector, not a linguistic one, and
# Hebrew speakers pause mid-clause. It also produced our BEST-EVER latency number while doing it,
# because a turn chopped in half finalises fast. See docs/phase-4-known-issues.md §11.
VOICE_TURN_DETECTION=vad
# Run the OTHER engine silently on real calls and log what it heard, for offline comparison.
# Off by default: it costs a second STT stream per call and the engine choice is already settled.
# Turn on when evaluating a new STT. Read the result with: npm run call:report
SHADOW_STT_ENABLED=false

# Agent spoken language (ISO 639-1)
VOICE_LANGUAGE=he

# Scheduling (Google Calendar)
# 1. Create a Service Account in Google Cloud Console and enable the Calendar API
# 2. Share your target calendar with the service account email (give it "Make changes to events" permission)
# 3. Set GOOGLE_CALENDAR_ID to the calendar's ID (found in Calendar Settings → Integrate calendar)
# 4. Set GOOGLE_CALENDAR_SERVICE_ACCOUNT_EMAIL to the service account's email address
# 5. Set GOOGLE_CALENDAR_PRIVATE_KEY to the private_key value from the service account JSON — keep \n as literal \n
GOOGLE_CALENDAR_ID=primary
GOOGLE_CALENDAR_SERVICE_ACCOUNT_EMAIL=scheduler@your-project.iam.gserviceaccount.com
GOOGLE_CALENDAR_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----
# Workspace user to impersonate so invites actually email out (requires Domain-Wide Delegation:
# admin.google.com -> Security -> API Controls -> Domain-wide delegation -> add the service
# account's CLIENT ID with scope https://www.googleapis.com/auth/calendar). Leave empty to book
# attendee-less events (no emailed invite).
GOOGLE_CALENDAR_IMPERSONATE_USER=
# Optional — defaults: 30 min slots, 09:00–18:00 working hours
GOOGLE_CALENDAR_SLOT_MINUTES=30
GOOGLE_CALENDAR_WORK_START=09:00
GOOGLE_CALENDAR_WORK_END=18:00

# AI (OpenAI)
# Optional. Without it the API still boots and warns; lead qualification, AI replies and
# post-call transcription/analysis are disabled and fail with OPENAI_NOT_CONFIGURED.
OPENAI_API_KEY=sk-
AI_MODEL=gpt-5.4

# Integrations - Monday.com
# Webhook signing secret from Monday.com (Settings → Developers → Webhooks)
MONDAY_WEBHOOK_SECRET=

# Integrations - Google Sheets
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Observability (Sentry)
# Get your DSN from https://sentry.io → Project Settings → Client Keys
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# CORS
CORS_ORIGINS=http://localhost:3001

# Voice end-of-turn tuning (LiveKit) — THE latency levers for Hebrew.
# No off-the-shelf end-of-turn model supports Hebrew (LiveKit's turn detectors and OpenAI's
# semantic_vad all exclude it), so we fall back to a silence timer. These two delays stack:
# end-of-turn ≈ max(Silero silence, minDelay). Measured ~1200-1440ms with the defaults below.
# Lower = snappier but risks cutting callers off mid-sentence. Sweep with `npm run voice:test`.
VOICE_VAD_MIN_SILENCE_MS=550
VOICE_ENDPOINTING_MIN_DELAY_MS=500
VOICE_ENDPOINTING_MAX_DELAY_MS=3000

# --- Per-tenant Google Calendar (OAuth) ---
# How a CUSTOMER connects their own calendar. A service account cannot be used for them:
# impersonating a user in their Workspace needs Domain-Wide Delegation, which needs admin rights in
# their Google account. One OAuth client serves every tenant; the grants live in oauth_connections.
# The redirect URI must match the Google console entry EXACTLY — Google compares it as a string.
GOOGLE_CALENDAR_OAUTH_CLIENT_ID=
GOOGLE_CALENDAR_OAUTH_CLIENT_SECRET=
GOOGLE_CALENDAR_OAUTH_REDIRECT_URI=https://your-api-host/webhooks/google-calendar/callback

# The tenant whose calendar the GOOGLE_CALENDAR_* service account above belongs to (ClickScales).
# Those vars are ONE TENANT'S credentials, not a global default — every other tenant must connect
# their own Google account or their agent has no booking tools.
PLATFORM_TENANT_ID=
