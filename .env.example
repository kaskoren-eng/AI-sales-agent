# Server
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Database
DATABASE_URL=postgresql://dev:dev@localhost:5432/ai_sales_agent

# Redis
REDIS_URL=redis://localhost:6379

# Encryption
ENCRYPTION_KEY=your-32-byte-hex-key-here

# JWT
JWT_SECRET=your-jwt-secret-here

# Operator console (super-admin). Optional: leave unset and every /api/v1/admin/* route replies 503.
# Set to a long random secret (>=24 chars) to enable the multi-tenant management console. This is a
# SEPARATE credential from tenant API keys — it grants cross-tenant powers (list/create/suspend/rotate).
ADMIN_API_KEY=

# Who may create a workspace: invite_only (default) or open.
#
# POST /auth/register creates a TENANT plus an owner account, and it is unauthenticated by
# necessity — obtaining a credential cannot itself require one. Left open, anyone who finds the API
# gets a workspace on a paid product, and a usage_period opens with it.
#
# LEAVE THIS UNSET unless you are deliberately opening self-serve signup. Closed locks nobody out:
# existing owners invite colleagues, and the first human on a new workspace comes from
# `node scripts/bootstrap-user.mjs --email you@example.com --tenant <slug>`, which needs database
# access — the right property for the power to mint a workspace.
SIGNUP_MODE=

# Lead intake webhooks
META_APP_SECRET=
LEAD_WEBHOOK_SECRET=
# UUID of the tenant that receives generic (non-Meta) webhook leads
LEAD_WEBHOOK_TENANT_ID=
# Netlify Forms bridge: the clickscales.com demo form lands in Netlify Forms, which relays each
# submission here as a JWS-signed webhook. Must equal the `signature_secret` on the site's
# submission_created `url` hook. Unset = the /webhooks/leads Netlify branch 401s.
NETLIFY_FORMS_WEBHOOK_SECRET=

# App base URL (for webhook callback URLs)
BASE_URL=http://localhost:3000
# Dashboard base URL — used for "view this call" links pushed into the CRM (Workstream B). Optional.
DASHBOARD_BASE_URL=http://localhost:3001

# ClickScales' own tenant id. The global integration credentials below (AIRTABLE_*, and in future
# GOOGLE_CALENDAR_*) are OUR account's, so only this tenant may fall back to them. Any other tenant
# must connect its own, or the step is skipped loudly. Leave unset and there is no fallback at all.
PLATFORM_TENANT_ID=
# Voicemail detection (outbound only, experimental). Off by default. When true, an outbound call that
# reaches an answering machine leaves a short message and hangs up instead of running discovery.
VOICE_AMD_ENABLED=false
# Advisory conversation-state layer (reflexes + stage/working-memory tracking + objection prompt).
# On by default. Set false to run Keren exactly as before the state machine — for A/B testing behaviour.
VOICE_STATE_MACHINE_ENABLED=true
# Hebrew number/time speech normalizer: clock times ("16:30" → "ארבע וחצי"), phone digits and round
# prices spoken as colloquial Hebrew words. Speech-only — transcripts keep the digits. On by default.
VOICE_SPEECH_NUMBERS_ENABLED=true
# Anti-repetition phrase ledger: tracks 4-grams already said this call, reminds the model per turn
# not to reuse them verbatim (turn-boundary system note; cache- and draft-safe). On by default.
VOICE_PHRASE_LEDGER_ENABLED=true
# Call identity memory: remembers what the lead already told her and what she already asked, and
# stops a garbled turn renaming an identified lead. On by default.
VOICE_FACT_MEMORY_ENABLED=true
# Count her discovery questions by INTENT, not just by literal phrasing, and remember the other four
# mandatory questions (who answers enquiries / frustration / how he closes / enquiries per day). A
# question asked after the lead has answered counts as going deeper, not as a re-ask. On by default;
# false restores the pre-2026-09-02 counting exactly. Inert when VOICE_FACT_MEMORY_ENABLED is false.
VOICE_ASK_INTENT_ENABLED=true
# Spoken-register nudge: reminds her at a turn boundary after two replies with no everyday word.
# On by default; inert when VOICE_SPOKEN_REGISTER_ENABLED is false.
VOICE_REGISTER_NUDGE_ENABLED=true
# Acknowledgement ledger: a wider bank of instant receipts, spent like a shuffled deck so the same
# word is not heard twice while others go unused. On by default.
VOICE_ACK_LEDGER_ENABLED=true
# Negation safety: prefer positive phrasings that cannot invert when the phone line swallows an
# unstressed לא. On by default; false restores the pre-2026-08-30 wording.
VOICE_NEGATION_SAFETY=true
# Spoken Register prompt section: simple spoken Hebrew + light slang (סבבה/אחלה level, no street
# slang). On by default; set false to restore the previous, more formal register.
VOICE_SPOKEN_REGISTER_ENABLED=true
# Mid-dictation nod: while the caller is reading out a phone number or an email she gives a short
# vocal nod ("אה אה") instead of a full receipt, which mid-number is an interruption. On by default.
VOICE_DICTATION_NOD_ENABLED=true
# Introduce yourself once: "נעים מאוד" belongs to the introduction, not to every captured fact.
# On by default; false restores the mid-call repeat.
VOICE_INTRO_ONCE_ENABLED=true
# Earned comprehension acknowledgement: "טוב, הבנתי" / "הבנתי אותך" are spoken only when the caller
# actually shared something, never twice running. On by default; false restores the flat five-word
# deck that said one of them on nearly every turn.
VOICE_ACK_EARNED_ENABLED=true
VOICE_FILLER_PAIRING_ENABLED=true
VOICE_OPENER_NO_REPEAT_ENABLED=true
VOICE_EMAIL_WHATSAPP_HANDBACK_ENABLED=true
# No Preamble: she stops acknowledging / mirroring / validating / announcing before every sentence
# and starts with the substance. The empathy beat and the opening slang are explicitly kept.
VOICE_NO_PREAMBLE_ENABLED=true
# Caller-engagement note: measures how many words the caller gives per turn and tells her whether
# to ask only the mandatory discovery questions or to go deeper. Advisory only. On by default.
VOICE_ENGAGEMENT_NOTE_ENABLED=true
# Email-dictation memory: stitch the letters the caller spells across his fragmented turns, remember
# a value he rejected out loud so it is never read back or saved again, and resolve the spoken domain
# ("ג'ימייל נקודה קום") to gmail.com. On by default; false restores the previous behaviour.
VOICE_EMAIL_DICTATION_ENABLED=true
# Let book_meeting close a booking with no email at all, after two failed read-backs: the event is
# created without an attendee and the confirmation goes to WhatsApp instead. On by default — the
# 31.8 call lost an agreed demo to this one field. false restores the hard email requirement.
VOICE_BOOK_WITHOUT_EMAIL=true
# Tool-call leak guard: nothing shaped like a tool call, a harmony control token, a JSON object
# or a CJK glitch run may reach the TTS on any path. On the 2026-08-31 13:52 production call the
# model emitted a tool call as plain text and Cartesia read it aloud for 19 seconds. On by
# default; false restores that behaviour and there is no good reason to.
VOICE_TOOLCALL_LEAK_GUARD_ENABLED=true
# Widen the false-booking rewrite past first person singular. On the 2026-08-31 16:51 production
# call she said "קבענו לאחת עשרה" ("WE booked for eleven") with nothing booked, and the guard that
# exists for exactly this only knew "קבעתי". On by default; false restores the five old patterns.
VOICE_BOOKING_CLAIM_GUARD_WIDE=true
# The code-truth booking reminder: "nothing has been booked yet, and here is what book_meeting still
# needs". Runs between the first availability check and a successful booking. On by default.
VOICE_BOOKING_NOTE_ENABLED=true
# Read the caller's own number back to him for confirmation instead of making him dictate it
# (inbound calls only). The one flag here that changes what she says on every inbound call.
VOICE_CALLER_PHONE_KNOWN_ENABLED=true
# Name-dictation memory: stitch the HEBREW letters the caller spells for his name across his
# fragmented turns, and refuse to join two garbled readings into a first-and-last name. On by
# default; false restores the previous behaviour (no note at all).
VOICE_NAME_DICTATION_ENABLED=true
# Step 3 may not disqualify before all three mandatory discovery questions are answered and the
# objection has been addressed once. She signed a lead off 79 seconds into the 16:51 call, on one
# answer. On by default; false restores the 2026-08-31 Step 3 exactly.
VOICE_LATE_DISQUALIFY_ENABLED=true

# Channels - WhatsApp (UChat)
UCHAT_WEBHOOK_SECRET=
UCHAT_API_TOKEN=
# UUID of the tenant that receives inbound WhatsApp messages (server-side only — prevents body spoofing)
UCHAT_WEBHOOK_TENANT_ID=

# Channels - Email (Resend)
# Optional. Without it the API still boots and warns; invites, password resets and meeting
# reminders are silently skipped, and POST /members/invites returns the raw token instead.
RESEND_API_KEY=re_
RESEND_FROM_EMAIL=sales@yourdomain.com
RESEND_WEBHOOK_SECRET=
# UUID of the tenant that receives inbound emails (MVP single-tenant routing)
RESEND_INBOUND_TENANT_ID=

# Channels - Voice (Zadarma SIP telephony into the LiveKit agent)
# Zadarma — https://zadarma.com
# 1. Get your API key and secret from Zadarma portal → Settings → API
# 2. Set notification URL in Zadarma → My Notifications: https://<your-domain>/webhooks/voice/zadarma
ZADARMA_API_KEY=
ZADARMA_API_SECRET=
ZADARMA_PHONE_NUMBER=
# UUID of the tenant that receives inbound voice calls — enables learning injection into agent prompt
VOICE_WEBHOOK_TENANT_ID=

# Channels - Voice (LiveKit self-built pipeline) — the REPLACEMENT engine. See VOICE_MIGRATION_PLAN.md
# The agent runs as its own process, not inside this server: npm run voice:dev
# LiveKit Cloud — https://cloud.livekit.io → Settings → Keys
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# OUTBOUND SIP trunk id (ST_...). Outbound only — the inbound trunk is configured entirely on
# LiveKit (trunk + dispatch rule) and is referenced by no env var. Unset = outbound calls
# silently no-op and return callId 'skipped'. See infra/livekit-sip/README.md.
LIVEKIT_SIP_OUTBOUND_TRUNK_ID=
# Optional: only needed once more than one inbound trunk exists.
LIVEKIT_SIP_INBOUND_TRUNK_ID=
# LOCAL ONLY, and never on a deployed API. Allows POST /web-call to honour {"agent":"local"} and
# dispatch a browser simulator session to the worker `npm run voice:dev` started on THIS machine
# (registered as VOICE_DEV_AGENT_NAME, default `keren-dev`) instead of the deployed cloud agent.
# Both the request field and this switch are required; with neither, /web-call is unchanged.
# `npm run voice:session` is the same thing without the API or the dashboard — see
# src/modules/channels/voice-livekit/testing/local-session.ts.
# VOICE_WEB_CALL_LOCAL_AGENT=1
# Cartesia (Hebrew TTS) — https://play.cartesia.ai → API Keys
# Browse Hebrew voices at https://play.cartesia.ai/voices (filter: language = Hebrew) and paste the voice ID below.
# Valid models: sonic, sonic-2, sonic-3, sonic-lite, sonic-turbo. There is no sonic-4.
CARTESIA_API_KEY=sk_car_
CARTESIA_MODEL=sonic-3
CARTESIA_VOICE_ID_PRIMARY=
# Backup Hebrew voices — A/B candidates for the Phase 2 voice selection
CARTESIA_VOICE_ID_SECONDARY=
CARTESIA_VOICE_ID_TERTIARY=

# Which TTS engine speaks: cartesia | deepdub | elevenlabs  (default cartesia — the shipped voice)
# 'deepdub' selects the self-built DeepDub adapter (won a blind Hebrew A/B on quality + native
# gender at cost parity; realtime model ~125ms TTFB). 'elevenlabs' selects the official plugin
# (eleven_flash_v2_5) for a Hebrew voice A/B. Strangler-fig, one var to revert.
VOICE_TTS_PROVIDER=deepdub
# Recorded-call legal notice pre-roll (Wiretapping Law 1979 §2). Off unless 'true'/'1'. Disabled
# for now: the choppy PSTN playback is worse than none pre-launch. Re-enable after the frame-size
# fix is verified on a real phone call. Code stays in compliance/recording-notice.ts.
# VOICE_RECORDING_NOTICE_ENABLED=false
# DeepDub (only needed when VOICE_TTS_PROVIDER=deepdub). Keys/voices at https://app.deepdub.ai
DEEPDUB_API_KEY=dd-
DEEPDUB_VOICE_PROMPT_ID=
DEEPDUB_MODEL=dd-etts-3.2
DEEPDUB_REALTIME=true
DEEPDUB_LOCALE=he-IL
DEEPDUB_EU=true
DEEPDUB_SAMPLE_RATE=24000
DEEPDUB_ACCENT_RATIO=0.75
# ElevenLabs (only needed when VOICE_TTS_PROVIDER=elevenlabs). Key at https://elevenlabs.io — voice
# ID from your Voice Library. voiceId is MANDATORY (missing = silent empty stream, not an error).
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_flash_v2_5
# Force Hebrew on the ws stream. Empty for flash/turbo_v2_5 (they reject language_code=he → 1008 close);
# set 'he' for eleven_multilingual_v2 (accepts it → clean Hebrew).
ELEVENLABS_LANGUAGE=
# WS handshake levers. multilingual_v2/v3 403 the websocket when auto_mode/sync_alignment are requested;
# keep both false so the quality models can connect over the ws (flash/turbo tolerate either).
ELEVENLABS_AUTO_MODE=false
ELEVENLABS_SYNC_ALIGNMENT=false
# Route via HTTP instead of the websocket. Required for eleven_v3 / Voice-Design "generated" voices
# (they 403 the ws and only render on v3, which is HTTP-only). true → LiveKit StreamAdapter over HTTP.
ELEVENLABS_USE_HTTP=false
# optimize_streaming_latency (0-4) on the HTTP path — higher = lower TTS TTFB, slightly lower quality.
# Leave empty to omit. HTTP path only.
ELEVENLABS_STREAMING_LATENCY=

# OpenAI streaming STT — uses the OPENAI_API_KEY below
OPENAI_REALTIME_MODEL=gpt-realtime-whisper

# Which STT engine transcribes the caller: soniox | openai
# SONIOX. Settled on real Hebrew calls, not on vibes: semantic WER 4.3% vs OpenAI's 34.9% on
# phone-like audio, end-of-turn ~572ms vs ~1113ms, and 8.5x cheaper. On a live call OpenAI heard
# the caller's name קורן as כהן (a different person) and turned the last digits of his mobile into
# the Hebrew word for "sun". Re-run it yourself: npm run stt:ab
STT_PROVIDER=soniox
# REQUIRED when STT_PROVIDER=soniox. https://console.soniox.com → API Keys
SONIOX_API_KEY=
# Name the real model: the plugin's 'stt-rt-v4' default is an ALIAS for v5 upstream, so pinning it
# lets a silent upstream swap change transcription quality overnight.
SONIOX_MODEL=stt-rt-v5
# Only used when VOICE_TURN_DETECTION=stt, which you should not turn on. Plugin clamps to 500–3000.
SONIOX_MAX_ENDPOINT_DELAY_MS=500
# How long the caller must stop producing new words before we draft a reply from what they've said
# so far (VOICE_TURN_DETECTION=stt only). This is the hit-rate lever for preemptive generation, and
# preemptive generation is the ONLY route under 1s: end-of-turn + LLM + TTS measured 1466ms running
# serially, so the reply must be written DURING the end-of-turn wait rather than after it.
# Lower = more overlap won, more drafts thrown away (one LLM call each). 0 disables it.
VOICE_PREEMPTIVE_PAUSE_MS=200
# How the turn ends: vad (silence timer) | stt (Soniox's own endpoint). LEAVE THIS ON vad.
# 'stt' was tested on a real call and CUT THE CALLER OFF ten times — the agent went silent on him
# three times mid-conversation. Soniox's endpoint is a silence detector, not a linguistic one, and
# Hebrew speakers pause mid-clause. It also produced our BEST-EVER latency number while doing it,
# because a turn chopped in half finalises fast. See docs/phase-4-known-issues.md §11.
VOICE_TURN_DETECTION=vad
# Run the OTHER engine silently on real calls and log what it heard, for offline comparison.
# Off by default: it costs a second STT stream per call and the engine choice is already settled.
# Turn on when evaluating a new STT. Read the result with: npm run call:report
SHADOW_STT_ENABLED=false

# Agent spoken language (ISO 639-1)
VOICE_LANGUAGE=he

# Scheduling (Google Calendar)
# 1. Create a Service Account in Google Cloud Console and enable the Calendar API
# 2. Share your target calendar with the service account email (give it "Make changes to events" permission)
# 3. Set GOOGLE_CALENDAR_ID to the calendar's ID (found in Calendar Settings → Integrate calendar)
# 4. Set GOOGLE_CALENDAR_SERVICE_ACCOUNT_EMAIL to the service account's email address
# 5. Set GOOGLE_CALENDAR_PRIVATE_KEY to the private_key value from the service account JSON — keep \n as literal \n
GOOGLE_CALENDAR_ID=primary
GOOGLE_CALENDAR_SERVICE_ACCOUNT_EMAIL=scheduler@your-project.iam.gserviceaccount.com
GOOGLE_CALENDAR_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----
# Workspace user to impersonate so invites actually email out (requires Domain-Wide Delegation:
# admin.google.com -> Security -> API Controls -> Domain-wide delegation -> add the service
# account's CLIENT ID with scope https://www.googleapis.com/auth/calendar). Leave empty to book
# attendee-less events (no emailed invite).
GOOGLE_CALENDAR_IMPERSONATE_USER=
# Optional — defaults: 30 min slots, 09:00–18:00 working hours
GOOGLE_CALENDAR_SLOT_MINUTES=30
GOOGLE_CALENDAR_WORK_START=09:00
GOOGLE_CALENDAR_WORK_END=18:00

# AI (OpenAI)
# Optional. Without it the API still boots and warns; lead qualification, AI replies and
# post-call transcription/analysis are disabled and fail with OPENAI_NOT_CONFIGURED.
OPENAI_API_KEY=sk-
AI_MODEL=gpt-5.4

# Integrations - Monday.com
# Webhook signing secret from Monday.com (Settings → Developers → Webhooks)
MONDAY_WEBHOOK_SECRET=

# Integrations - Airtable (per-tenant CRM sync)
# ClickScales' own Airtable account. Tenants connect their own from the dashboard Integrations
# page; only PLATFORM_TENANT_ID may fall back to these. See src/queues/workers/flow-executor.worker.ts.
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE_ID=
# Column NAMES used to look a lead up in that base (defaults: Phone / Email)
AIRTABLE_PHONE_FIELD=
AIRTABLE_EMAIL_FIELD=

# Integrations - Airtable leads board (Koren's sales pipeline)
# A SEPARATE base from AIRTABLE_* above. Every new lead created for PLATFORM_TENANT_ID by the
# lead-intake webhook (website form + Meta Lead Ads) gets a row here, one-way, fire-and-forget.
# Unset any of the three and the push is skipped — intake and the outbound call are unaffected.
# PAT needs only the data.records:write scope on the base below.
AIRTABLE_LEADS_PAT=
AIRTABLE_LEADS_BASE_ID=app7IOcK9NvTvHyBm
AIRTABLE_LEADS_TABLE_ID=tblP4AW6CQLxZVO1P

# Integrations - Google Sheets
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Observability (Sentry)
# Get your DSN from https://sentry.io → Project Settings → Client Keys
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# CORS
CORS_ORIGINS=http://localhost:3001

# ── The <1s lever ────────────────────────────────────────────────────────────────────────────
# Say "אוקיי" the instant the turn ends, before the model has written a word.
#
# THE ONLY THING THAT PUTS FIRST AUDIO UNDER A SECOND. Measured budget (npm run bench:path):
# end-of-turn ~400ms + LLM first token ~974ms + TTS first byte ~217ms. The middle term is not
# tunable — the speech guard releases the opener 25ms after the first token, so the pipeline
# already streams correctly and the wait is just how long gpt-5.4 takes to start. A real ANSWER
# cannot beat ~1.6s; an acknowledgement lands at ~620ms and the answer follows behind it.
#
# This changes how she sounds on EVERY turn. If it reads as a tic rather than as listening, this
# is the switch — do not start editing the phrase list first.
VOICE_INSTANT_ACK=true
# How long she may stay deliberately silent (caller said "רגע") before checking back in.
# 0 disables the watchdog and restores the indefinite silence that cost 20s of a live call.
VOICE_HOLD_CHECKBACK_MS=7000
# How long the CALLER may sit in silence before she checks he is still there. This is LiveKit's
# `userAwayTimeout` (seconds on their side), which defaulted to 15s and produced two 15.3s dead
# lines on the 2026-08-31 production call. 15000 restores that default; 0 disables the silence
# reflex entirely.
VOICE_SILENCE_AWAY_MS=7000
# How long the caller may THINK before she says anything about the silence. Separate from the
# away timeout above, which is LiveKit's own state machine and drives report attribution. On the
# 2026-08-31 13:52 call a shared 7s fired the nudge twice inside the first minute, both times into
# a pause the caller was still thinking in. Every away event on our two instrumented production
# calls was a thinking caller, never a dead line; the longest genuine pause measured ~18s.
# 0 restores the 2026-08-31 behaviour (nudge the moment the SDK says 'away').
VOICE_SILENCE_NUDGE_MS=20000
# ── The 2026-08-31 19:54 call, Koren's eleven conclusions ─────────────────────────────────────
# A disqualifying end_call (not_qualified / not_interested) must rest on the LEAD's own words. At
# 260s she was cut off mid-conditional, the caller's half-second reply — spoken INSIDE her speech
# window — came back as her own sentence minus its negation, and she read that as a yes and hung up
# on a lead she had recorded as "hot" 96 seconds earlier. The gate refuses a hang-up built on an
# overlap, an echo or an inference, and makes her ask first. opt_out is never delayed (legal), and
# the gate stops refusing after two so a caller can always get off the phone.
VOICE_END_CALL_CONFIRM_ENABLED=true
# The earned-acknowledgement test reads the turn the model is ANSWERING instead of the last
# COMMITTED turn — with preemptive generation the committed field is one turn behind, which is why
# "טוב, הבנתי" landed after four questions on that call. false restores the stale source.
VOICE_ACK_EARNED_FROM_CONTEXT=true
# One question per reply, enforced: the second question sentence in a reply is dropped before it is
# spoken. false speaks both, as on 2026-08-31.
VOICE_ONE_QUESTION_ENABLED=true
# She must never narrate her own instructions, register or delivery to a caller. The sentence is
# dropped, never rewritten. false speaks it.
VOICE_SELF_NARRATION_GUARD_ENABLED=true
# The prompt half of the same eleven conclusions: sentence shape over comma chains, the meanings of
# the screened slang bank, unambiguous positives for product claims, empathy-first on a stated
# concern, discovery that establishes whether there IS a business, and mandatory questions that
# persist until answered. false restores the 2026-08-31 prompt sections exactly.
VOICE_CALL4_PROMPT_ENABLED=true
# The sales model: 7-stage flow, Gate A, 5 mandatory questions, interest check.
# See docs/gtm/keren-sales-model.md. Default false.
VOICE_SALES_MODEL_ENABLED=false
# Koren's twelfth conclusion: the short opener at the head of every reply is a LATENCY device, and
# it buys nothing when the reply is one short line. It becomes conditional — spoken on a turn whose
# answer is long or complex, silent on a short one — in the code that speaks it and in the prompt
# that describes it, together. false restores the every-turn receipt exactly, in both halves.
VOICE_ACK_ONLY_WHEN_NEEDED=true
# Round 19, 2026-09-02: when the caller ASKED something, she answers him instead of receipting him
# first — the first sound is her own "כן.." / "אז", never our "בסדר.". false restores the receipt.
VOICE_ACK_SKIP_ON_QUESTION=true
# Round 19 f1: on a step that spoke a receipt and then only called a tool, a hesitation is spoken
# behind it ("אמ. רֶגַע...") to cover the tool round-trip. false restores "no words, no hesitation".
VOICE_TOOL_FILLER_PAIR_ENABLED=true
# 2026-09-01 09:29. A sentence already sent to the TTS inside the last 30s is not sent again —
# she began the same reply three times in seven seconds, and apologised twice for one failed
# booking. Questions are exempt, and so is a repeat the caller asked for. false restores it.
VOICE_REPEAT_GUARD_ENABLED=true
# She asked "בוקר, או אחר הצהריים?" four times after he had answered, and he ended the call. Day,
# part of day and hour are now tracked from his own words. false and nothing is tracked.
VOICE_SLOT_MEMORY_ENABLED=true
# "עדיף שנעצור כאן" with no end_call behind it becomes "אתה רוצה שנעצור כאן?" — she may not
# announce an ending she is not carrying out. A farewell is untouched. false restores it.
VOICE_STOP_ANNOUNCE_GUARD_ENABLED=true
# Round-13 s2, enforced: "זה עובד אחלה" becomes "זה עובד מעולה". Slang for rapport is untouched.
VOICE_PRODUCT_CLAIM_SLANG_GUARD=true
# Pauses inside a reply — <break time="0.15s|0.25s|0.35s"/>, written by the model where thinking is
# plausible and validated by the speech guard. OFF deletes every tag. See voice-mode.ts.
VOICE_VOICE_MODES_ENABLED=false
# Mid-call disconnect tracking: when the caller hangs up mid-conversation, mark the call
# (end_reason=caller_hung_up), and — from the discovery stage onward — raise a callback row and
# ping the business owner. A hangup during the opening greeting is recorded only. Default OFF;
# OFF is exactly the pre-2026-09-03 behaviour (the listener is not registered at all).
VOICE_DISCONNECT_TRACKING=false
# Starts the worker that DIALS the callbacks table — the rung ladder from
# docs/phase-8-callback-and-followup-model.md §7, then it stops. Default OFF because ON means a
# background queue placing real outbound calls; OFF does not construct the worker at all, so the
# rows simply wait. Needs LIVEKIT_SIP_OUTBOUND_TRUNK_ID, or every callback fails loudly on the row.
VOICE_CALLBACK_WORKER=false
# The schedule_callback tool — she can write down "תתקשר אליי עוד שעה" instead of losing it. OFF
# means the tool is not registered at all, so the model never sees it. Ships dark: the prompt does
# not mention it (F1.7) and no confirmation message is sent (F1.5). Turning this on without
# VOICE_CALLBACK_WORKER writes rows that nothing dials.
VOICE_CALLBACK_TOOL=false
# The OLD hesitation noise ("אממ...", "רגע..."), prepended to a reply that took this long to start.
# 0 = off, and it IS off: VOICE_INSTANT_ACK replaced it, and running both stacks two noises on one
# turn. Capped at 3 per call when on — it fired 21 times in a 7-minute call and read as a tic.
VOICE_THINKING_FILLER_MS=0
# OpenAI service tier for the voice turn. 'priority' costs ~2x per token; measure before assuming
# it helps — `npm run bench:tier` A/Bs it with interleaved runs. Leave empty for the default tier.
VOICE_LLM_SERVICE_TIER=priority

# Voice end-of-turn tuning (LiveKit) — THE latency levers for Hebrew.
# No off-the-shelf end-of-turn model supports Hebrew (LiveKit's turn detectors and OpenAI's
# semantic_vad all exclude it), so we fall back to a silence timer. These two delays stack:
# end-of-turn ≈ max(Silero silence, minDelay). Measured ~1200-1440ms with the defaults below.
# Lower = snappier but risks cutting callers off mid-sentence. Sweep with `npm run voice:test`.
VOICE_VAD_MIN_SILENCE_MS=550
VOICE_ENDPOINTING_MIN_DELAY_MS=500
VOICE_ENDPOINTING_MAX_DELAY_MS=3000

# --- Per-tenant Google Calendar (OAuth) ---
# How a CUSTOMER connects their own calendar. A service account cannot be used for them:
# impersonating a user in their Workspace needs Domain-Wide Delegation, which needs admin rights in
# their Google account. One OAuth client serves every tenant; the grants live in oauth_connections.
# The redirect URI must match the Google console entry EXACTLY — Google compares it as a string.
GOOGLE_CALENDAR_OAUTH_CLIENT_ID=
GOOGLE_CALENDAR_OAUTH_CLIENT_SECRET=
GOOGLE_CALENDAR_OAUTH_REDIRECT_URI=https://your-api-host/webhooks/google-calendar/callback

# The tenant whose calendar the GOOGLE_CALENDAR_* service account above belongs to (ClickScales).
# Those vars are ONE TENANT'S credentials, not a global default — every other tenant must connect
# their own Google account or their agent has no booking tools.
PLATFORM_TENANT_ID=
