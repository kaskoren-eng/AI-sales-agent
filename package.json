{
  "name": "ai-sales-agent",
  "version": "0.1.0",
  "description": "Multi-channel AI sales agent: WhatsApp/Email/Voice - qualifies leads, books calls",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:generate": "tsx ./node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "tsx ./node_modules/drizzle-kit/bin.cjs migrate",
    "db:studio": "tsx ./node_modules/drizzle-kit/bin.cjs studio",
    "db:migrate:prod": "node dist/db/migrate.js",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ci": "vitest run --reporter=default --reporter=junit --outputFile=test-results.xml",
    "typecheck": "tsc --noEmit",
    "voice:download": "livekit-agents download-files",
    "voice:dev": "tsx --env-file=.env src/modules/channels/voice-livekit/agent.ts dev",
    "voice:connect": "tsx --env-file=.env src/modules/channels/voice-livekit/agent.ts connect --room",
    "voice:test": "tsx --env-file=.env src/modules/channels/voice-livekit/testing/run-scenarios.ts",
    "voice:tts:smoke": "tsx --env-file=.env scripts/deepdub-tts-smoke.ts",
    "voice:start": "node dist/modules/channels/voice-livekit/agent.js start",
    "screenshot": "node scripts/screenshot.mjs",
    "screenshot:dash": "BASE_URL=http://localhost:3002 node scripts/screenshot.mjs",
    "screenshot:dev": "cd dashboard && npm run dev &amp; sleep 4 &amp;&amp; node ../scripts/screenshot.mjs",
    "stt:corpus": "tsx --env-file=.env scripts/generate-stt-test-corpus.ts",
    "stt:ab": "tsx --env-file=.env tests/stt-ab-test.ts",
    "voice:ab": "tsx --env-file=.env src/modules/channels/voice-livekit/testing/voice-ab.ts",
    "voice:clarity": "tsx --env-file=.env src/modules/channels/voice-livekit/testing/clarity-ab.ts",
    "stt:shadow": "node --env-file=.env scripts/analyze-shadow-stt.mjs",
    "call:report": "node scripts/show-call-report.mjs",
    "call:stats": "node scripts/call-stats.mjs",
    "bench:tts": "tsx --env-file=.env src/modules/channels/voice-livekit/testing/latency-bench.ts tts",
    "bench:llm": "tsx --env-file=.env src/modules/channels/voice-livekit/testing/latency-bench.ts llm",
    "call:fetch": "node scripts/fetch-cloud-calls.mjs",
    "agent:deploy": "node scripts/deploy-agent.mjs deploy",
    "agent:logs": "lk agent logs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@deepdub/node": "^3.0.2",
    "@fastify/cookie": "^11.0.0",
    "@fastify/cors": "^10.0.0",
    "@fastify/formbody": "^8.0.2",
    "@fastify/helmet": "^13.0.0",
    "@fastify/jwt": "^9.0.0",
    "@fastify/rate-limit": "^10.2.0",
    "@fastify/static": "^9.1.3",
    "@livekit/agents": "^1.5.1",
    "@livekit/agents-plugin-cartesia": "^1.5.1",
    "@livekit/agents-plugin-elevenlabs": "^1.5.1",
    "@livekit/agents-plugin-livekit": "^1.5.1",
    "@livekit/agents-plugin-openai": "^1.5.1",
    "@livekit/agents-plugin-silero": "^1.5.1",
    "@livekit/agents-plugin-soniox": "^1.5.1",
    "@livekit/noise-cancellation-node": "^0.1.10",
    "@livekit/rtc-node": "^0.13.31",
    "@sentry/node": "^10.51.0",
    "bullmq": "^5.30.0",
    "dotenv": "^17.4.1",
    "drizzle-orm": "^0.39.0",
    "fastify": "^5.2.0",
    "fastify-plugin": "^5.0.0",
    "googleapis": "^144.0.0",
    "ioredis": "^5.4.0",
    "livekit-server-sdk": "^2.17.0",
    "openai": "^6.34.0",
    "papaparse": "^5.4.0",
    "pg": "^8.13.0",
    "resend": "^4.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/papaparse": "^5.3.0",
    "@types/pg": "^8.11.0",
    "drizzle-kit": "^0.31.10",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
