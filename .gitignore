node_modules/
dist/

# Secrets — glob, not exact names. `.env` alone did NOT cover `.env.agent.bak`
# or `.env.bak-soniox`, so `git add -A` would have staged live production keys.
.env*
!.env.example

*.log
.DS_Store
.vscode/
*.tsbuildinfo
.claude/
screenshots/

# Voice A/B samples — regenerate with `npm run voice:ab`
voice-samples/

# Call reports — contain caller phone numbers and transcripts (PII). Never commit.
call-reports/

# Agent deploy secrets — never commit.
# The GLOB matters: `.env.agent` alone does not match `.env.agent.bak-stt`, and a rollback backup
# of a secrets file is still a secrets file. One was staged on 2026-08-18 before this line existed.
.env.agent
.env.agent.*
.agent-build/
.agent-secrets.env

# Probe output (WAVs + results.json) — reproducible, do not commit
el-ws-probe/

# Browser-automation snapshots — can capture env-var panels with live secrets
.playwright-cli/

# Local Netlify folder
.netlify
